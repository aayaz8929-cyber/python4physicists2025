
heights = [10.67, 11.01, 9.67, 11.40]
diameters = [4.65, 5.55, 5.01, 5.89]

#Convert diameters to radii
radii = [d / 2 for d in diameters]

# compute volumes
pi = 3.14
volumes = []

for i in range(len(heights)):
    r = radii[i]
    h = heights[i]
    V = pi * (r ** 2) * h
    volumes.append(round(V, 2))

# print results
for i, v in enumerate(volumes, start=1):
    print(f"Volume {i}: {v} cm³")
